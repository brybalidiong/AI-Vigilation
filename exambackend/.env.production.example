# Copy to .env.production on the server. Never commit the filled-in file.
API_DOMAIN=api.example.com
DJANGO_DEBUG=0
USE_LOCAL_SQLITE=0
USE_LOCAL_MEDIA=0
DJANGO_TRUST_PROXY_HTTPS=1
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://ai-vigilation.vercel.app
DJANGO_SECRET_KEY=replace-with-a-new-random-secret-of-at-least-50-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
ALLOWED_SCHOOL_DOMAIN=dnsc.edu.ph

# Copy the Session pooler URI from Supabase > Connect (port 5432), or use
# the direct URI if the VM can reach your Supabase project's IPv6 address.
# Percent-encode reserved characters in the database password.
DATABASE_URL=postgresql://postgres.project-ref:replace-password@pooler-host:5432/postgres

# Generate server-side S3 access keys in Supabase > Storage > S3.
# Create a private bucket called media in Supabase Storage first.
AWS_STORAGE_BUCKET_NAME=media
AWS_S3_ENDPOINT_URL=https://project-ref.storage.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=your-project-region
AWS_ACCESS_KEY_ID=replace-with-s3-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
