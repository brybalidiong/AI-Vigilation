# Local development. Production must set DJANGO_DEBUG=0 and the values below.
USE_LOCAL_SQLITE=1
USE_LOCAL_MEDIA=1
DJANGO_DEBUG=1
ALLOWED_SCHOOL_DOMAIN=dnsc.edu.ph

# Production secrets and allowed origins (configure in your host's secret manager):
# DJANGO_SECRET_KEY=generate-a-new-long-random-value
# DJANGO_ALLOWED_HOSTS=api.example.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

# Enable only if your trusted proxy overwrites incoming X-Forwarded-Proto.
# DJANGO_TRUST_PROXY_HTTPS=1
# DJANGO_HTTPS_REDIRECT=1
# Set HSTS after HTTPS has been verified for the production domain.
# DJANGO_HSTS_SECONDS=60

# Choose DATABASE_URL or all four DB_* settings for PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
# DB_HOST=database.example.com
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=secret
# DB_PORT=5432
# DB_SSLMODE=require

# Firebase Admin: an absolute mounted file path or platform-provided JSON secret.
# FIREBASE_CREDENTIALS=/run/secrets/firebase-service-account.json
# FIREBASE_CREDENTIALS_JSON={...}

# S3-compatible media storage, required when USE_LOCAL_SQLITE=0.
# Supabase Storage S3 endpoint/region and server-side access keys come from
# the project's Storage > S3 settings. Create a private media bucket first.
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_STORAGE_BUCKET_NAME=media
# AWS_S3_ENDPOINT_URL=https://storage.example.com
# AWS_S3_REGION_NAME=region-name

# Mount private face models and gaze assets at these paths in production.
# FACE_MODELS_DIR=/app/models
# GAZE_ASSETS_DIR=/app/gaze-assets
# GADGET_MODEL_PATH=/app/models/yolo11n.pt

# Required when more than one ASGI process handles WebSockets.
# REDIS_URL=redis://redis-host:6379/0
