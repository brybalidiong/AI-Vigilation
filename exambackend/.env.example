ALLOWED_SCHOOL_DOMAIN=dnsc.edu.ph
INSTRUCTOR_USERNAME=instructor
INSTRUCTOR_PASSWORD=change_me_to_a_strong_password

# 0 = Supabase Postgres + S3 media (default). 1 = local SQLite + disk media.
USE_LOCAL_SQLITE=0

# Prefer DATABASE_URL from Supabase dashboard (Session pooler, port 5432):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres

DB_HOST=aws-1-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-supabase-db-password
DB_CONNECT_TIMEOUT=15
DB_SSLMODE=require
